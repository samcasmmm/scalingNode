    "express": "^4.22.2",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "hpp": "^0.2.3",
    "inquirer": "^13.4.3",
    "jsonwebtoken": "^9.0.3",
    "juice": "^11.1.1",
    "moment": "^2.30.1",
    "nodemailer": "^7.0.13",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.9",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.2.2",
