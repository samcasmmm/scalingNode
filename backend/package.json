  "repository": {
    "type": "git",
    "url": "git+https://github.com/[username]/[repo_name].git"
  },
  "homepage": "https://github.com/[username]/[repo_name]#readme",
  "bugs": {
    "url": "https://github.com/[username]/[repo_name]/issues"
  },
  "scripts": {
    "clean": "rimraf public/dist",
    "build": "tsc -p tsconfig.json",
    "build:dev": "cross-env NODE_ENV=development npm run build",
    "build:prod": "cross-env NODE_ENV=production npm run build",
    "dev": "tsx watch src/index.ts",
    "start": "node public/dist/index.js",
    "start:dev": "cross-env NODE_ENV=development npm run start",
    "start:prod": "cross-env NODE_ENV=production npm run start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/database/seed/index.ts",
    "make": "node scripts/create-module.js",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "check": "prettier . --check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@scalar/express-api-reference": "^0.9.20",
    "@types/hpp": "^0.2.7",
